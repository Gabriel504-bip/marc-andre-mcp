# ============================================================
# Accès ENTRANT — qui a le droit d'appeler CE serveur MCP
# (serveur hébergé à distance : ce jeton doit être configuré
# côté Claude/Cowork comme en-tête Authorization: Bearer ...)
# ============================================================
MCP_BEARER_TOKEN=change-me-generate-a-long-random-secret-min-48-chars

# ============================================================
# Accès SORTANT — ce serveur MCP vers marc-andre-app
# ⚠️ Les routes /api/agent/* N'EXISTENT PAS ENCORE côté
# marc-andre-app. Elles sont spécifiées dans PALIERS.md et ne
# seront implémentées qu'après le GO explicite de Gabriel.
# Tant qu'elles n'existent pas, tous les outils échoueront avec
# une UpstreamError claire (404), jamais un plantage silencieux.
# ============================================================
MA_BASE_URL=https://marc-andre-app.example.com
MA_AGENT_KEY=change-me-agent-api-key
MA_AGENT_ID=claude-cowork-gabriel

# ============================================================
# Comportement
# ============================================================
# Palier 2 FERMÉ par défaut — décision de Gabriel (2026-08-12).
# Tant que ce n'est pas exactement "true", les outils du palier 2
# ne sont même pas enregistrés : Claude ne peut pas être tenté par
# un outil qu'il ne voit pas dans son catalogue.
MA_ALLOW_TIER2=false

MA_TIMEOUT_MS=15000
MA_CACHE_TTL_MS=300000
MA_LOG_FILE=./agent-actions.jsonl

# Facultatif — décision D8 : restreindre l'agent à une liste de
# dossiers pendant une phase pilote, avant d'ouvrir tout le cabinet.
# AGENT_ALLOWED_CLIENTS=sessionTokenA,sessionTokenB

# Geste d'urgence : couper l'agent sans redéployer (voir README).
AGENT_ENABLED=true
